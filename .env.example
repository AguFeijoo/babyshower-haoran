# Cadena de conexión de Neon (Dashboard de Neon > Connect). Si la dejás vacía, la app usa datos en memoria.
DATABASE_URL=

# Login de los papás (si no se definen, se usan los valores hardcodeados de lib/config.ts)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión (cualquier texto largo y aleatorio)
SESSION_SECRET=
